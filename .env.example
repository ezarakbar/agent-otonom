# AGENT OTONOM configuration
AGENT_HOST=127.0.0.1
AGENT_PORT=8790
# Leave unset to auto-detect repo root
# AGENT_ROOT=/absolute/path/to/agent-otonom
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
SOVITS_BASE_URL=http://127.0.0.1:9880
# Required for GPT-SoVITS api_v2: path to a speaker reference WAV
SOVITS_REF_AUDIO=/absolute/path/to/agent-otonom/models/sovits/ref_speaker.wav
SOVITS_PROMPT_TEXT=Hello, this is a calm cinematic narrator speaking clearly for voice cloning.
SOVITS_PROMPT_LANG=en
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Prefer photoreal SD1.5 (run scripts/bootstrap-pro-media.sh)
COMFY_CHECKPOINT=Realistic_Vision_V5.1_fp16-no-ema.safetensors
# Keep false so ComfyUI + GPT-SoVITS stay primary (Piper/slideshow only if true)
ALLOW_ENGINE_FALLBACK=false
PIPER_BIN=
PIPER_MODEL=
WORKER_CONCURRENCY=1
JOB_TIMEOUT_SEC=3600
LOG_LEVEL=INFO
ALLOW_DYNAMIC_WORKFLOWS=true
REQUIRE_CONFIRM_NEW_WORKFLOW=true
REQUIRE_PRODUCTION_BRIEF=true
AUTO_EXECUTE_PRODUCTION=true
ENABLE_WEB_RESEARCH=true
LIPSYNC_BASE_URL=
JOB_TIMEOUT_SEC=7200
